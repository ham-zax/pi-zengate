{
  "name": "pi-zengate-models",
  "version": "1.0.1",
  "description": "Pi provider extension that discovers free models and their metadata from an OpenAI-compatible gateway catalog, with a local cache and no scheduler.",
  "keywords": [
    "pi-package",
    "pi-extension",
    "opencode2api",
    "zengate",
    "openai-compatible"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "files": [
    "extensions",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./extensions/zengate-models.ts"
    ]
  },
  "scripts": {
    "test": "node --test test/mapping.test.mjs"
  }
}
